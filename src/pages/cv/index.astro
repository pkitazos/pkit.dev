---
import Layout from "@/layouts/PageLayout.astro";
import CvListItem from "@/components/CvListItem.astro";
---

<Layout title="CV">
  <section class="flex-1 pt-20">
    <h1 class="font-mono text-xl mb-8">CV</h1>
    <p class="my-3 text-muted max-w-xl">Depending on what you're after:</p>
    <ul role="list" class="list-disc ml-4">
      <CvListItem name="industry" ext="pdf" href="/cv/petros-kitazos-industry.pdf" />
      <CvListItem name="academic" ext="pdf" href="/cv/petros-kitazos-academic.pdf" />
    </ul>
  </section>
</Layout>
