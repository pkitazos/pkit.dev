---
interface Props {
  name: string;
  ext: string;
  href: string;
}

const { name, ext, href } = Astro.props;
---

<li class="hover:underline decoration-2 hover:decoration-indigo-500 hover:marker:text-indigo-500 hover:translate-x-1.5 transition-transform">
  <a href={href} target="_blank" rel="noopener">
    {name}
    <span class="text-muted">.{ext}</span>
  </a>
</li>
